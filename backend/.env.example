APP_ENV=development
# 次の操作と入力する文字列を選ぶ。最後の答えの文章にも使う。実行に必須。
# https://aistudio.google.com/ で取得。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# ブラウザを表示せずに操作する場合は true
BROWSER_HEADLESS=false
# TypeSafe Jev。操作の危険度の判定と、実行前の見積もりに必須。https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
# この確率以上の操作は、人間の確認がなければ実行しない
TYPESAFE_RISK_THRESHOLD=0.7
# 確認を待つ上限（秒）
APPROVAL_TIMEOUT_SECONDS=120
# タスクの完了・エラー時に Windows の標準通知を出すか
ENABLE_NOTIFICATIONS=true
# FRONTEND_DIR=../frontend
