APP_ENV=development
# 入力文・最終回答に使用。文字情報だけで答えを確認できないときは画面画像も送る。
# https://aistudio.google.com/ で取得。未設定では画像からの回答は使えない。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# ブラウザを表示せずに操作する場合は true
BROWSER_HEADLESS=false
# TypeSafe Jev。次の操作の選択に必須。https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# この確率以上の操作は、人間の確認がなければ実行しない
TYPESAFE_RISK_THRESHOLD=0.7
# 確認を待つ上限（秒）
APPROVAL_TIMEOUT_SECONDS=120
# タスクの完了・エラー時に Windows の標準通知を出すか
ENABLE_NOTIFICATIONS=true
# FRONTEND_DIR=../frontend
