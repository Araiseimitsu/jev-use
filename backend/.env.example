APP_ENV=development
# 入力する文字列と、最後の答えの文章にだけ使う（画面の判断には使わない）
# https://aistudio.google.com/ で取得。未設定でも操作はでき、答えはページの抜粋になる。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# ブラウザを表示せずに操作する場合は true
BROWSER_HEADLESS=false
# TypeSafe Jev。次の操作の選択に必須。https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# この確率以上の操作は、人間の確認がなければ実行しない
TYPESAFE_RISK_THRESHOLD=0.7
# 確認を待つ上限（秒）
APPROVAL_TIMEOUT_SECONDS=120
# タスクの完了・エラー時に Windows の標準通知を出すか
ENABLE_NOTIFICATIONS=true
# FRONTEND_DIR=../frontend
